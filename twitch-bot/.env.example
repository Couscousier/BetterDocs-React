# ===== Claude (IA) =====
# Clé API : https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Modèle et niveau de réflexion (low = réponses rapides, adapté au chat)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# ===== Twitch =====
# Application créée sur https://dev.twitch.tv/console (Redirect URL : http://localhost:3000)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Compte Twitch du bot (à mettre modérateur : /mod nomdubot)
TWITCH_BOT_USERNAME=
# Obtenus avec `npm run auth` (connecte-toi avec le compte du bot)
TWITCH_BOT_ACCESS_TOKEN=
TWITCH_BOT_REFRESH_TOKEN=
# Ta chaîne
TWITCH_CHANNEL=

# ===== Personnalité =====
STREAMER_NICKNAME=
BOT_PERSONA=Un bot taquin et bienveillant, fan de la commu, qui adore les jeux de mots.
BOT_EXTRA_INFO=Discord : https://discord.gg/xxxx | YouTube : https://youtube.com/@xxxx | Les lives commencent en général vers 20h.
TIMEZONE=Europe/Paris
CHAT_USER_COOLDOWN_SEC=20
CHAT_GLOBAL_COOLDOWN_SEC=4
ANSWER_KEYWORD_QUESTIONS=true

# ===== Clips automatiques =====
AUTOCLIP_ENABLED=true
AUTOCLIP_COOLDOWN_SEC=180
AUTOCLIP_HYPE_RATIO=2.5
AUTOCLIP_MIN_MESSAGES=8
CLIP_VOTES_REQUIRED=3

# ===== Modération =====
MODERATION_ENABLED=true
# true = le bot logue ce qu'il ferait sans sanctionner (conseillé les premiers lives)
MODERATION_DRY_RUN=true
MODERATION_PROTECT_VIEWERS=false
MODERATION_TIMEOUT_SEC=600
MODERATION_STRIKES_BEFORE_TIMEOUT=2
# Pseudos jamais sanctionnés, séparés par des virgules (potes qui chambrent)
MODERATION_TRUSTED_USERS=
